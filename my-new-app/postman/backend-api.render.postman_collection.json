            "url": "{{baseUrl}}/api/posts?title=Phong+tro+Q1&description=Mo+ta&address=123+Le+Loi&ward=Ben+Nghe&district=1&city=Ho+Chi+Minh&latitude=10.762622&longitude=106.660172&price=3000000&area=20&roomType=PHONG_TRO&amenities=Wifi&amenities=May+lanh"
          }
        },
        {
          "name": "PUT /api/posts/:postId (multipart + query)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "images", "type": "file", "src": "" }
              ]
            },
            "url": "{{baseUrl}}/api/posts/{{postId}}?title=Cap+nhat+tin&description=Mo+ta+moi&address=123+Le+Loi&ward=Ben+Nghe&district=1&city=Ho+Chi+Minh&price=3200000&area=22&roomType=PHONG_TRO"
          }
        },
        {
          "name": "PATCH /api/posts/:postId/status",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/api/posts/{{postId}}/status?status=ACTIVE"
          }
        },
        {
          "name": "DELETE /api/posts/:postId",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/api/posts/{{postId}}"
          }
        },
        {
          "name": "GET /api/posts/:postId/reviews",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/api/posts/{{postId}}/reviews"
          }
        },
        {
          "name": "POST /api/posts/:postId/reviews",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rating\": 5,\n  \"comment\": \"Phong sach se, gia hop ly\"\n}"
            },
            "url": "{{baseUrl}}/api/posts/{{postId}}/reviews"
          }
        },
        {
          "name": "GET /api/posts/admin",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/api/posts/admin?page=0&size=20"
          }
        }
      ]
